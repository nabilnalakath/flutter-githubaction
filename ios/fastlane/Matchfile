# Code signing certificates and profiles are stored, encrypted, in a private
# git repository. match reads these from the environment:
#   MATCH_GIT_URL                  HTTPS URL of that repository
#   MATCH_PASSWORD                 passphrase used to encrypt it
#   MATCH_GIT_BASIC_AUTHORIZATION  base64 of "username:token" (CI only)
#                                  The token expires; when CI can't clone the
#                                  repository any more, create a new one.
storage_mode("git")
type("appstore")
